BOT_USERNAME=apix_ai_bot
# ── Bot ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=https://apixbotai.com
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=change_me_to_random_string
WEB_PUBLIC_URL=https://apixbotai.com
TELEGRAM_STARTUP_COMMANDS_ENABLED=false

# Admin Telegram IDs
ADMIN_IDS=[123456789]

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose: приложение внутри контейнера ходит к сервису postgres.
DATABASE_URL=postgresql+asyncpg://bot:secret@postgres:5432/artflow

# Локальный запуск без Docker Compose:
# DATABASE_URL=postgresql+asyncpg://bot:secret@localhost:5433/artflow

DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_SECONDS=21600
DB_BACKUP_DIR=data/db_backups
DB_BACKUP_KEEP_LAST=4

DB_PASSWORD=secret

# ── Redis ────────────────────────────────────────────────────────────────────
# Docker Compose: приложение внутри контейнера ходит к сервису redis.
REDIS_URL=redis://redis:6379
# Локальный запуск без Docker Compose:
# REDIS_URL=redis://localhost:6379
# Если Redis недоступен — бот запустится на MemoryStorage (FSM без персистентности)

# ── CometAPI ─────────────────────────────────────────────────────────────────
COMET_API_KEY=your_cometapi_key_here
COMET_BASE_URL=https://api.cometapi.com
COMET_ASSISTANT_MODEL=gpt-5.4
COMET_ASSISTANT_FALLBACK=gpt-5.4-mini

APIX_WATCHER_ENABLED=false

# ── YooKassa ─────────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_PROVIDER_TOKEN=your_telegram_provider_token

# ── CryptoBot ────────────────────────────────────────────────────────────────
CRYPTOBOT_TOKEN=your_cryptobot_token_here
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api

# ── T-Bank Acquiring ─────────────────────────────────────────────────────────
TBANK_TERMINAL_KEY=your_terminal_key
TBANK_PASSWORD=your_terminal_password
TBANK_BASE_URL=https://securepay.tinkoff.ru/v2
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=

# ── Lava.top ─────────────────────────────────────────────────────────────────
LAVA_API_KEY=your_lava_api_key
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_WEBHOOK_PATH=/webhook/lava
LAVA_DEFAULT_EMAIL=buyer@example.com
LAVA_OFFER_ID_CREDITS_100=
LAVA_OFFER_ID_CREDITS_300=
LAVA_OFFER_ID_CREDITS_1000=

# ── Web auth email delivery (SMTP) ──────────────────────────────────────────
WEB_AUTH_EMAIL_ENABLED=false
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=no-reply@mail.example.com
RESEND_FROM_NAME="APIX Studio"
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="APIX Studio"
SMTP_REPLY_TO=support@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── Web registration CAPTCHA (Cloudflare Turnstile) ────────────────────────
# Создайте widget в Cloudflare Turnstile, ограничьте hostnames рабочими доменами
# и включите серверную проверку токена на регистрации.
WEB_CAPTCHA_ENABLED=true
WEB_CAPTCHA_PROVIDER=turnstile
WEB_CAPTCHA_SITE_KEY=your_turnstile_site_key
WEB_CAPTCHA_SECRET_KEY=your_turnstile_secret_key

# ── Features ─────────────────────────────────────────────────────────────────
SUBSCRIPTION_ENABLED=false
TELEGRAM_STARS_ENABLED=false

# ── Credits ──────────────────────────────────────────────────────────────────
WELCOME_BONUS_CREDITS=15
REFERRAL_L1_CREDITS=20
REFERRAL_WITHDRAW_MIN_RUB=1000
REFERRAL_L2_CREDITS=10

# ── aivideoapi.ai (HappyHorse 1.0) ──────────────────────────────────────────
AIVIDEOAPI_KEY=sk-your-aivideoapi-key-here

# ── kie.ai (Wan 2.7 Image Pro) ───────────────────────────────────────────────
KIE_AI_KEY=your-kie-ai-key-here
KIE_WEBHOOK_SECRET=change_me_to_random_kie_webhook_secret

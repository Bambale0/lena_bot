BOT_USERNAME=apix_ai_bot
# ── Bot ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=https://testapi.chillcreative.ru
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=change_me_to_random_string

# Admin Telegram IDs
ADMIN_IDS=[123456789]

# ── Database ─────────────────────────────────────────────────────────────────
# Если postgres локально установлен (sudo apt install postgresql):
DATABASE_URL=postgresql+asyncpg://bot:secret@localhost:5432/artflow

# Если используешь Docker для postgres (порт 5433):
# DATABASE_URL=postgresql+asyncpg://bot:secret@localhost:5433/artflow

DB_PASSWORD=secret

# ── Redis ────────────────────────────────────────────────────────────────────
# Если redis локально (sudo apt install redis-server):
REDIS_URL=redis://localhost:6666
# Если Redis недоступен — бот запустится на MemoryStorage (FSM без персистентности)

# ── CometAPI ─────────────────────────────────────────────────────────────────
COMET_API_KEY=your_cometapi_key_here
COMET_BASE_URL=https://api.cometapi.com
COMET_ASSISTANT_MODEL=gpt-5.4
COMET_ASSISTANT_FALLBACK=gpt-5.4-mini

# ── YooKassa ─────────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_PROVIDER_TOKEN=your_telegram_provider_token

# ── CryptoBot ────────────────────────────────────────────────────────────────
CRYPTOBOT_TOKEN=your_cryptobot_token_here
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api

# ── T-Bank Acquiring ─────────────────────────────────────────────────────────
TBANK_TERMINAL_KEY=your_terminal_key
TBANK_PASSWORD=your_terminal_password
TBANK_BASE_URL=https://securepay.tinkoff.ru/v2
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=

# ── Features ─────────────────────────────────────────────────────────────────
SUBSCRIPTION_ENABLED=false
TELEGRAM_STARS_ENABLED=false

# ── Credits ──────────────────────────────────────────────────────────────────
WELCOME_BONUS_CREDITS=15
REFERRAL_L1_CREDITS=20
REFERRAL_WITHDRAW_MIN_RUB=1000
REFERRAL_L2_CREDITS=10

# ── aivideoapi.ai (HappyHorse 1.0) ──────────────────────────────────────────
AIVIDEOAPI_KEY=sk-your-aivideoapi-key-here

# ── kie.ai (Wan 2.7 Image Pro) ───────────────────────────────────────────────
KIE_AI_KEY=your-kie-ai-key-here

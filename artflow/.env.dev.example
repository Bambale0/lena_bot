# APIX dev bot environment
# Copy to .env.dev and fill real secrets. Do not commit .env.dev.

ENV=development
APIX_WEB_DEV_AUTH=true

# Telegram: create a separate bot via BotFather for dev/staging.
BOT_TOKEN=0000000000:replace_with_dev_bot_token
BOT_USERNAME=apix_ai_dev_bot
WEBHOOK_URL=https://dev-apix.example.com
WEBHOOK_PATH=/webhook/telegram/dev
WEBHOOK_SECRET=replace_with_random_dev_webhook_secret
WEB_PUBLIC_URL=https://dev-apix.example.com

# Admin/test users only.
ADMIN_IDS=[]
WELCOME_BONUS_CREDITS=100
TELEGRAM_STARS_ENABLED=false
SUBSCRIPTION_ENABLED=false
REFERRAL_FREEZE=true
DB_BACKUP_ENABLED=false

# Internal docker-compose.dev-bot.yml networking overrides these at runtime.
DATABASE_URL=postgresql+asyncpg://bot:secret@postgres:5432/artflow_dev
REDIS_URL=redis://redis:6379/1

# Provider keys. Use sandbox/dev keys where possible.
COMET_API_KEY=replace_with_dev_or_sandbox_key
COMET_BASE_URL=https://api.cometapi.com
KIE_AI_KEY=
AIVIDEOAPI_KEY=

# Provider callbacks for the dev public URL.
KIE_WEBHOOK_PATH=/webhook/kie/dev
KIE_WEBHOOK_SECRET=replace_with_random_dev_kie_secret
KIE_WEBHOOK_HMAC_KEY=
MIDJOURNEY_WEBHOOK_PATH=/webhook/comet/midjourney/dev
MIDJOURNEY_WEBHOOK_SECRET=replace_with_random_dev_midjourney_secret
STATIC_UPLOAD_PUBLIC_BASE_URL=https://dev-apix.example.com

# Payments: keep disabled or use sandbox credentials only.
CRYPTOBOT_TOKEN=
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_SUCCESS_URL=https://dev-apix.example.com/app
TBANK_FAIL_URL=https://dev-apix.example.com/app
LAVA_API_KEY=
LAVA_WEBHOOK_PATH=/webhook/lava/dev
LAVA_DEFAULT_EMAIL=dev@example.com

# Optional email/web auth dev settings.
WEB_AUTH_EMAIL_ENABLED=false
RESEND_API_KEY=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

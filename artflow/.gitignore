.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
venv/
.agents/
# Local runtime data
*.db
*.sqlite
*.sqlite3
pgdata/
redisdata/
static/upload/*
data/db_backup_state.json
data/db_backups/
logs/
.logs/*
!.logs/.gitkeep

# Temporary and backup files
*.bak
*.bak2
*.bak_*
tmp_*.py
backups/
.patch_*
.tmp_apix_archive/

# Frontend
webapp/dist/
webapp/node_modules/
webapp/.vite/
webapp/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archives and local binaries
*.zip
.bin
.log
nginx.conf.bak3

# HappyFox relay: local certs/secrets, never commit.
# NOTE: keep this narrowly scoped to the relay directory + known secret
# filenames. Blanket *happyfox* globs would silently ignore future source
# files such as bot/handlers/happyfox.py or docs/happyfox_relay.md.
happyfox-relay-cert/
happyfox-relay-cert/*.pem
happyfox-relay-cert/*.key
happyfox-relay-cert/*.p12
happyfox-relay-cert/secrets*.json

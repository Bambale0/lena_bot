# Banano Mini App frontend. API and uploads remain on the production backend.
server {
    listen 80;
    server_name tanyapp.chillcreative.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name tanyapp.chillcreative.ru;

    ssl_certificate /etc/letsencrypt/live/tanyapp.chillcreative.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tanyapp.chillcreative.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    client_max_body_size 60M;
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / {
        return 302 /mini-app/;
    }

    location = /mini-app {
        return 308 /mini-app/;
    }

    location ^~ /mini-app/api/ {
        proxy_pass https://tanyapi.chillcreative.ru;
        proxy_ssl_server_name on;
        proxy_ssl_name tanyapi.chillcreative.ru;
        proxy_http_version 1.1;
        proxy_set_header Host tanyapi.chillcreative.ru;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    location ^~ /api/v1/ {
        proxy_pass https://tanyapi.chillcreative.ru;
        proxy_ssl_server_name on;
        proxy_ssl_name tanyapi.chillcreative.ru;
        proxy_http_version 1.1;
        proxy_set_header Host tanyapi.chillcreative.ru;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }

    location ^~ /uploads/ {
        proxy_pass https://tanyapi.chillcreative.ru;
        proxy_ssl_server_name on;
        proxy_ssl_name tanyapi.chillcreative.ru;
        proxy_http_version 1.1;
        proxy_set_header Host tanyapi.chillcreative.ru;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
    }

    location ^~ /mini-app/_next/static/ {
        proxy_pass http://banano-miniapp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /mini-app/telegram-web-app.js {
        proxy_pass http://banano-miniapp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location /mini-app/ {
        proxy_pass http://banano-miniapp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location / {
        return 404;
    }
}

